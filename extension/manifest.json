{
  "manifest_version": 3,
  "name": "NoteMate for chess.com",
  "version": "0.1.0",
  "description": "Open your finished chess.com games in NoteMate for analysis. Does nothing while a game is in progress.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "NoteMate",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "background": {
    "service_worker": "background.js",
    "scripts": ["lib/settings.js", "lib/chesscom-api.js", "lib/handoff.js", "background.js"]
  },
  "permissions": ["storage"],
  "host_permissions": ["https://api.chess.com/*", "http://localhost/*", "http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*"],
      "js": ["lib/gameover.js", "content/chesscom.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "notemate-chesscom@localhost", "strict_min_version": "121.0" }
  }
}
